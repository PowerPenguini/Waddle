import { Palette } from "std-widgets.slint";

import {
    DialogKind,
    FileItem,
    FolderRow,
    SystemTheme,
    PreviewKind,
    ViewMode,
} from "types.slint";

import { AppDialog } from "components/app-dialog.slint";
import { GridBrowser } from "components/grid-browser.slint";
import { RangerBrowser } from "components/ranger-browser.slint";
import { SidebarTree } from "components/sidebar-tree.slint";

export component AppWindow inherits Window {
    title: "PolarExp";
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 660px;
    min-height: 420px;
    background: transparent;
    forward-focus: browser-key-target;

    in property <[FileItem]> files;
    in property <[FolderRow]> folder-rows;
    in property <[FileItem]> ranger-parent-files;
    in property <[FileItem]> ranger-preview-files;
    in property <int> ranger-parent-selected: -1;
    in property <ViewMode> view-mode: ViewMode.grid;
    in property <PreviewKind> preview-kind: PreviewKind.empty;
    in property <string> preview-title;
    in property <string> preview-metadata;
    in property <string> preview-text;
    in-out property <string> location-text;
    in property <string> status-text;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-parent;
    in property <bool> busy;
    in property <bool> navigation-loading;
    in property <int> selected-entry: -1;
    in property <[bool]> selected-entries;
    in property <bool> visual-selection-active;
    out property <bool> location-focused;
    in-out property <bool> search-active;
    in-out property <string> search-text;
    in property <bool> recursive-search-active;
    in property <bool> search-loading;
    in property <int> search-result-count: -1;
    in property <bool> search-results-truncated;
    in-out property <bool> command-active;
    in-out property <string> command-text;
    in-out property <string> command-prefix: "!";
    in-out property <bool> command-output-active;
    in property <string> command-output-summary;
    in property <string> command-output-detail;
    in-out property <bool> drag-selection-active;
    in-out property <length> drag-selection-start-x;
    in-out property <length> drag-selection-start-y;
    in-out property <length> drag-selection-current-x;
    in-out property <length> drag-selection-current-y;
    in-out property <bool> delete-operator-pending;

    in property <DialogKind> dialog-kind: DialogKind.none;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <string> dialog-detail;
    in-out property <string> dialog-input;
    in property <string> dialog-error;

    callback back-requested();
    callback forward-requested();
    callback parent-requested();
    callback copy-requested(int);
    callback paste-requested();
    callback search-started();
    callback search-changed(string);
    callback search-submitted();
    callback search-cancelled();
    callback search-repeat-requested(bool);
    callback recursive-search-mode-requested(bool);
    callback command-submitted(string);
    callback view-mode-requested(ViewMode);
    callback location-submitted(string);
    callback entry-clicked(int);
    callback entry-double-clicked(int);
    callback entry-context-selected(int);
    callback selection-move-requested(int, int, int);
    callback visual-selection-toggled();
    callback visual-selection-cancelled();
    callback drag-selection-requested(int, int, int, int, int);
    callback drag-selection-finished();
    callback delete-selection-requested();
    callback delete-operator-cancelled();
    callback delete-operator-motion-requested(string, int);
    callback selected-entry-activated();
    callback ranger-selection-requested(int);
    callback ranger-entry-activated(int);
    callback ranger-parent-activated(int);
    callback ranger-selection-move-requested(int);
    callback ranger-left-requested();
    callback tree-row-activated(int);
    pure callback entry-drop-allowed(data-transfer, int) -> bool;
    callback entry-dropped(data-transfer, int) -> bool;
    pure callback ranger-parent-drop-allowed(data-transfer, int) -> bool;
    callback ranger-parent-dropped(data-transfer, int) -> bool;
    pure callback tree-drop-allowed(data-transfer, int) -> bool;
    callback tree-dropped(data-transfer, int) -> bool;
    callback rename-requested(int);
    callback trash-requested(int);
    callback name-submitted(string);
    callback dialog-cancelled();
    callback dialog-confirmed();
    callback apply-system-theme(bool, brush, bool, brush);
    public function focus-browser() {
        if root.dialog-kind == DialogKind.none && !root.search-active && !root.command-active {
            browser-key-target.focus();
        }
    }

    apply-system-theme(has-accent, detected-accent, has-selection-foreground, detected-selection-foreground) => {
        SystemTheme.has-accent = has-accent;
        SystemTheme.detected-accent = detected-accent;
        SystemTheme.has-selection-foreground = has-selection-foreground;
        SystemTheme.detected-selection-foreground = detected-selection-foreground;
    }

    private property <length> content-gutter: 14px;
    private property <length> tile-width: 104px;
    private property <length> tile-pitch: 112px;
    private property <length> grid-workspace-width: max(1px, root.width - 220px);
    private property <int> grid-columns: Math.max(1, Math.floor((root.grid-workspace-width - 2 * root.content-gutter) / root.tile-pitch));
    private property <length> grid-column-width: (root.grid-workspace-width - 2 * root.content-gutter) / root.grid-columns;
    private property <length> grid-viewport-y;

    public pure function grid-selection-row-at(x: length, y: length) -> int {
        Math.floor((y - 47px - root.content-gutter - root.grid-viewport-y) / 116px)
    }

    public pure function grid-selection-column-at(x: length, y: length) -> int {
        Math.floor((x - 220px - root.content-gutter) / root.grid-column-width)
    }

    public pure function grid-selection-columns() -> int {
        root.grid-columns
    }

    public pure function grid-selection-start-allowed(x: length, y: length) -> bool {
        if root.view-mode != ViewMode.grid || root.busy || root.navigation-loading
            || root.recursive-search-active {
            return false;
        }
        let grid-x = x - 220px - root.content-gutter;
        let content-y = y - 47px - root.content-gutter - root.grid-viewport-y;
        let column = Math.floor(grid-x / root.grid-column-width);
        let row = Math.floor(content-y / 116px);
        if grid-x < 0px || x >= root.width - root.content-gutter
            || y < 47px + root.content-gutter || y >= root.height - 26px - root.content-gutter
            || column < 0 || column >= root.grid-columns || row < 0 {
            return false;
        }
        let item-index = row * root.grid-columns + column;
        let tile-left = column * root.grid-column-width
            + (root.grid-column-width - root.tile-width) / 2;
        let inside-tile = item-index < root.files.length
            && grid-x >= tile-left && grid-x < tile-left + root.tile-width
            && content-y - row * 116px >= 0px && content-y - row * 116px < 108px;
        !inside-tile
    }
    private property <int> grid-rows: Math.ceil(root.files.length / root.grid-columns);

    changed busy => {
        if !root.busy && root.dialog-kind == DialogKind.none && !root.search-active && !root.command-active {
            browser-key-target.focus();
        }
    }
    changed dialog-kind => {
        if root.dialog-kind == DialogKind.none && !root.busy && !root.search-active && !root.command-active {
            browser-key-target.focus();
        }
    }
    changed navigation-loading => {
        if root.navigation-loading && root.search-active {
            root.search-active = false;
            root.search-text = "";
            root.search-cancelled();
        }
        if root.navigation-loading && root.command-active {
            root.command-active = false;
            root.command-text = "";
        }
    }

    browser-shortcuts := FocusScope {
        init => { browser-key-target.focus(); }

        // Keep the file area opaque while leaving the sidebar backed by the
        // native transparent/blurred window surface.
        if root.view-mode == ViewMode.grid : Rectangle {
            x: 220px;
            width: max(0px, parent.width - self.x);
            background: Palette.background;
        }

        KeyBinding {
            keys: @keys(Control + C);
            enabled: !root.location-focused && !root.search-active && !root.command-active && root.selected-entry >= 0;
            activated => { root.copy-requested(root.selected-entry); }
        }

        KeyBinding {
            keys: @keys(Control + V);
            enabled: !root.location-focused && !root.search-active && !root.command-active;
            activated => { root.paste-requested(); }
        }

        KeyBinding {
            keys: @keys(Escape);
            enabled: root.search-active || root.command-active || root.command-output-active
                || root.visual-selection-active || root.delete-operator-pending;
            activated => {
                if root.search-active {
                    root.search-active = false;
                    root.search-text = "";
                    root.search-cancelled();
                } else if root.command-active {
                    root.command-active = false;
                    root.command-text = "";
                } else if root.command-output-active {
                    root.command-output-active = false;
                } else if root.visual-selection-active {
                    root.visual-selection-cancelled();
                } else {
                    root.delete-operator-pending = false;
                    root.delete-operator-cancelled();
                }
                browser-key-target.focus();
            }
        }

        key-pressed(event) => {
            if root.dialog-kind != DialogKind.none || root.busy {
                return reject;
            }
            if root.search-active || root.command-active {
                return reject;
            }
            // Some Wayland virtual keyboards emit the control character
            // instead of the printable key while Control is held.
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == "c" || event.text == "\u{3}") && root.selected-entry >= 0 {
                root.copy-requested(root.selected-entry);
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == "v" || event.text == "\u{16}") {
                root.paste-requested();
                return accept;
            }
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if root.delete-operator-pending {
                root.delete-operator-pending = false;
                if event.text == "0" || event.text == "$" || event.text == "h"
                    || event.text == "j" || event.text == "k" || event.text == "l"
                    || event.text == "d" {
                    root.delete-operator-motion-requested(
                        event.text,
                        root.view-mode == ViewMode.ranger ? 1 : root.grid-columns,
                    );
                } else {
                    root.delete-operator-cancelled();
                }
                return accept;
            }
            if event.text == "/" {
                root.command-output-active = false;
                root.search-text = "";
                root.search-started();
                root.search-active = true;
                return accept;
            }
            if event.text == "!" {
                if root.navigation-loading {
                    return accept;
                }
                root.command-output-active = false;
                root.command-prefix = "!";
                root.command-text = "";
                root.command-active = true;
                return accept;
            }
            if event.text == ":" {
                if root.navigation-loading {
                    return accept;
                }
                root.command-output-active = false;
                root.command-prefix = ":";
                root.command-text = "";
                root.command-active = true;
                return accept;
            }
            if event.text == "n" {
                root.search-repeat-requested(false);
                return accept;
            }
            if event.text == "N" {
                root.search-repeat-requested(true);
                return accept;
            }
            if event.text == Key.Backspace && root.can-go-parent {
                root.parent-requested();
                return accept;
            }
            if event.text == Key.Delete && root.selected-entry >= 0 {
                root.delete-selection-requested();
                return accept;
            }
            if event.text == "y" && root.selected-entry >= 0 {
                root.copy-requested(root.selected-entry);
                return accept;
            }
            if event.text == "p" {
                root.paste-requested();
                return accept;
            }
            if event.text == "v" {
                root.visual-selection-toggled();
                return accept;
            }
            if event.text == "x" && root.selected-entry >= 0 {
                root.delete-selection-requested();
                return accept;
            }
            if event.text == "d" && root.selected-entry >= 0 {
                if root.visual-selection-active {
                    root.delete-selection-requested();
                } else {
                    root.delete-operator-pending = true;
                }
                return accept;
            }
            if root.view-mode == ViewMode.ranger && event.text == "h" {
                root.ranger-left-requested();
                return accept;
            }
            if root.view-mode == ViewMode.ranger && event.text == "j" {
                root.ranger-selection-move-requested(1);
                return accept;
            }
            if root.view-mode == ViewMode.ranger && event.text == "k" {
                root.ranger-selection-move-requested(-1);
                return accept;
            }
            if root.view-mode == ViewMode.ranger && event.text == "l" {
                root.selected-entry-activated();
                return accept;
            }
            if root.view-mode == ViewMode.grid && event.text == "h" {
                root.selection-move-requested(-1, 0, root.grid-columns);
                return accept;
            }
            if root.view-mode == ViewMode.grid && event.text == "j" {
                root.selection-move-requested(0, 1, root.grid-columns);
                return accept;
            }
            if root.view-mode == ViewMode.grid && event.text == "k" {
                root.selection-move-requested(0, -1, root.grid-columns);
                return accept;
            }
            if root.view-mode == ViewMode.grid && event.text == "l" {
                root.selection-move-requested(1, 0, root.grid-columns);
                return accept;
            }
            if event.text == Key.Return {
                root.selected-entry-activated();
                return accept;
            }
            return reject;
        }

        browser-key-target := FocusScope {
            width: 0px;
            height: 0px;
            focus-on-click: false;
            focus-on-tab-navigation: false;
        }


        if root.view-mode == ViewMode.grid : HorizontalLayout {
            spacing: 0px;

            SidebarTree {
                rows: root.folder-rows;
                busy: root.busy;
                navigation-loading: root.navigation-loading;
                activated(index) => { root.tree-row-activated(index); }
                drop-allowed(data, index) => { root.tree-drop-allowed(data, index) }
                dropped(data, index) => { root.tree-dropped(data, index) }
            }

            grid-browser := GridBrowser {
                files: root.files;
                selected-entry: root.selected-entry;
                selected-entries: root.selected-entries;
                busy: root.busy;
                navigation-loading: root.navigation-loading;
                can-go-back: root.can-go-back;
                can-go-forward: root.can-go-forward;
                can-go-parent: root.can-go-parent;
                location-text <=> root.location-text;
                status-text: root.delete-operator-pending
                    ? "d  •  awaiting motion: 0, $, h, j, k, l, or d"
                    : root.status-text;
                search-active: root.search-active;
                search-text <=> root.search-text;
                recursive-search-active: root.recursive-search-active;
                search-loading: root.search-loading;
                search-result-count: root.search-result-count;
                search-results-truncated: root.search-results-truncated;
                command-active: root.command-active;
                command-text <=> root.command-text;
                command-prefix: root.command-prefix;
                command-output-active <=> root.command-output-active;
                command-output-summary: root.command-output-summary;
                command-output-detail: root.command-output-detail;
                view-mode: root.view-mode;
                columns: root.grid-columns;
                rows: root.grid-rows;
                column-width: root.grid-column-width;
                tile-width: root.tile-width;
                content-gutter: root.content-gutter;
                drag-selection-active: root.drag-selection-active;
                drag-selection-start-x: root.drag-selection-start-x - 220px;
                drag-selection-start-y: root.drag-selection-start-y - 47px;
                drag-selection-current-x: root.drag-selection-current-x - 220px;
                drag-selection-current-y: root.drag-selection-current-y - 47px;
                viewport-y <=> root.grid-viewport-y;
                back-requested => { root.back-requested(); }
                forward-requested => { root.forward-requested(); }
                parent-requested => { root.parent-requested(); }
                location-focus-changed(focused) => { root.location-focused = focused; }
                location-submitted(path) => { root.location-submitted(path); }
                view-mode-requested(mode) => { root.view-mode-requested(mode); }
                search-changed(query) => { root.search-changed(query); }
                recursive-search-mode-requested(enabled) => { root.recursive-search-mode-requested(enabled); }
                command-submitted(command) => {
                    root.command-active = false;
                    root.command-text = "";
                    root.command-submitted(command);
                    browser-key-target.focus();
                }
                command-cancelled => {
                    root.command-active = false;
                    root.command-text = "";
                    browser-key-target.focus();
                }
                search-submitted => {
                    root.search-active = false;
                    root.search-submitted();
                    browser-key-target.focus();
                }
                entry-clicked(index) => { root.entry-clicked(index); }
                entry-double-clicked(index) => { root.entry-double-clicked(index); }
                entry-context-selected(index) => { root.entry-context-selected(index); }
                rename-requested(index) => { root.rename-requested(index); }
                trash-requested(index) => { root.trash-requested(index); }
                entry-drop-allowed(data, index) => { root.entry-drop-allowed(data, index) }
                entry-dropped(data, index) => { root.entry-dropped(data, index) }
            }
        }

        if root.view-mode == ViewMode.ranger : ranger-browser := RangerBrowser {
            files: root.files;
            parent-files: root.ranger-parent-files;
            preview-files: root.ranger-preview-files;
            selected-entry: root.selected-entry;
            selected-entries: root.selected-entries;
            parent-selected: root.ranger-parent-selected;
            busy: root.busy;
            navigation-loading: root.navigation-loading;
            can-go-back: root.can-go-back;
            can-go-forward: root.can-go-forward;
            can-go-parent: root.can-go-parent;
            location-text <=> root.location-text;
            status-text: root.delete-operator-pending
                ? "d  •  awaiting motion: 0, $, h, j, k, l, or d"
                : root.status-text;
            search-active: root.search-active;
            search-text <=> root.search-text;
            recursive-search-active: root.recursive-search-active;
            search-loading: root.search-loading;
            search-result-count: root.search-result-count;
            search-results-truncated: root.search-results-truncated;
            command-active: root.command-active;
            command-text <=> root.command-text;
            command-prefix: root.command-prefix;
            command-output-active <=> root.command-output-active;
            command-output-summary: root.command-output-summary;
            command-output-detail: root.command-output-detail;
            preview-kind: root.preview-kind;
            preview-title: root.preview-title;
            preview-metadata: root.preview-metadata;
            preview-text: root.preview-text;
            content-gutter: root.content-gutter;
            back-requested => { root.back-requested(); }
            forward-requested => { root.forward-requested(); }
            parent-requested => { root.parent-requested(); }
            location-focus-changed(focused) => { root.location-focused = focused; }
            location-submitted(path) => { root.location-submitted(path); }
            view-mode-requested(mode) => { root.view-mode-requested(mode); }
            search-changed(query) => { root.search-changed(query); }
            recursive-search-mode-requested(enabled) => { root.recursive-search-mode-requested(enabled); }
            command-submitted(command) => {
                root.command-active = false;
                root.command-text = "";
                root.command-submitted(command);
                browser-key-target.focus();
            }
            command-cancelled => {
                root.command-active = false;
                root.command-text = "";
                browser-key-target.focus();
            }
            search-submitted => {
                root.search-active = false;
                root.search-submitted();
                browser-key-target.focus();
            }
            selection-requested(index) => { root.ranger-selection-requested(index); }
            entry-activated(index) => { root.ranger-entry-activated(index); }
            parent-activated(index) => { root.ranger-parent-activated(index); }
            context-selected(index) => { root.entry-context-selected(index); }
            rename-requested(index) => { root.rename-requested(index); }
            trash-requested(index) => { root.trash-requested(index); }
            entry-drop-allowed(data, index) => { root.entry-drop-allowed(data, index) }
            entry-dropped(data, index) => { root.entry-dropped(data, index) }
            parent-drop-allowed(data, index) => { root.ranger-parent-drop-allowed(data, index) }
            parent-dropped(data, index) => { root.ranger-parent-dropped(data, index) }
        }
    }

    if root.dialog-kind != DialogKind.none : AppDialog {
        kind: root.dialog-kind;
        title: root.dialog-title;
        message: root.dialog-message;
        detail: root.dialog-detail;
        input <=> root.dialog-input;
        error: root.dialog-error;
        busy: root.busy;
        name-submitted(name) => { root.name-submitted(name); }
        cancelled => { root.dialog-cancelled(); }
        confirmed => { root.dialog-confirmed(); }
    }
}
