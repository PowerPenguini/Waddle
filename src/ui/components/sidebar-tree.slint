import { ListView, Palette } from "std-widgets.slint";
import { FolderRow } from "../types.slint";
import { FolderTreeRow } from "folder-tree-row.slint";

export component SidebarTree inherits Rectangle {
    in property <[FolderRow]> rows;
    in property <bool> busy;
    in property <bool> navigation-loading;
    callback activated(int);
    pure callback drop-allowed(data-transfer, int) -> bool;
    callback dropped(data-transfer, int) -> bool;

    width: 220px;
    background: @linear-gradient(112deg,
        Palette.alternate-background.transparentize(0.10) 0%,
        Palette.alternate-background.transparentize(0.20) 58%,
        Palette.background.transparentize(0.12) 100%);
    accessible-role: complementary;

    VerticalLayout {
        spacing: 0px;
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 12px;
        padding-right: 12px;

        Text {
            text: "Locations";
            height: 30px;
            color: Palette.alternate-foreground;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            opacity: 0.68;
        }

        ListView {
            for row[index] in root.rows : FolderTreeRow {
                width: parent.width;
                row-data: row;
                row-index: index;
                drop-enabled: !root.busy && !root.navigation-loading;
                activated(index) => { root.activated(index); }
                drop-allowed(data, index) => { root.drop-allowed(data, index) }
                dropped(data, index) => { root.dropped(data, index) }
            }
        }
    }
}
