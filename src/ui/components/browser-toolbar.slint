import { Palette } from "std-widgets.slint";
import { ViewMode } from "../types.slint";
import { FlatLineInput } from "flat-line-input.slint";
import { ToolbarIconButton } from "toolbar-icon-button.slint";
import { ViewModeSwitch } from "view-mode-switch.slint";

export component BrowserToolbar inherits Rectangle {
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-parent;
    in property <bool> busy;
    in-out property <string> location-text;
    in property <ViewMode> view-mode;
    in property <length> content-gutter: 14px;
    out property <bool> location-focused: location-editor.has-focus;
    callback back-requested();
    callback forward-requested();
    callback parent-requested();
    callback location-focus-changed(bool);
    callback location-submitted(string);
    callback view-mode-requested(ViewMode);

    changed location-focused => { root.location-focus-changed(self.location-focused); }

    height: 46px;
    background: Palette.background;
    accessible-role: banner;

    HorizontalLayout {
        padding-left: root.content-gutter;
        padding-right: root.content-gutter;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;

        ToolbarIconButton {
            icon: @image-url("../icons/up.svg");
            enabled: root.can-go-parent && !root.busy;
            label: "Parent folder";
            clicked => { root.parent-requested(); }
        }

        ToolbarIconButton {
            icon: @image-url("../icons/back.svg");
            enabled: root.can-go-back && !root.busy;
            label: "Back";
            clicked => { root.back-requested(); }
        }

        ToolbarIconButton {
            icon: @image-url("../icons/forward.svg");
            enabled: root.can-go-forward && !root.busy;
            label: "Forward";
            clicked => { root.forward-requested(); }
        }

        location-editor := FlatLineInput {
            horizontal-stretch: 1;
            text <=> root.location-text;
            enabled: !root.busy;
            input-label: "Location";
            font-size: 14px;
            accepted => { root.location-submitted(self.text); }
        }

        ViewModeSwitch {
            mode: root.view-mode;
            requested(mode) => { root.view-mode-requested(mode); }
        }
    }
}
