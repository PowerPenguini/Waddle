import { ListView, Palette } from "std-widgets.slint";
import { FileItem, SystemTheme, ViewMode } from "../types.slint";
import { BrowserToolbar } from "browser-toolbar.slint";
import { BrowserStatusBar } from "browser-status-bar.slint";
import { FileTile } from "file-tile.slint";

export component GridBrowser inherits VerticalLayout {
    in property <[FileItem]> files;
    in property <int> selected-entry: -1;
    in property <[bool]> selected-entries;
    in property <bool> busy;
    in property <bool> navigation-loading;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-parent;
    in-out property <string> location-text;
    in property <string> status-text;
    in property <bool> search-active;
    in-out property <string> search-text;
    in property <bool> recursive-search-active;
    in property <bool> search-loading;
    in property <int> search-result-count: -1;
    in property <bool> search-results-truncated;
    in property <bool> command-active;
    in-out property <string> command-text;
    in property <string> command-prefix: "!";
    in-out property <bool> command-output-active;
    in property <string> command-output-summary;
    in property <string> command-output-detail;
    in property <ViewMode> view-mode;
    in property <int> columns: 1;
    in property <int> rows: 0;
    in property <length> column-width;
    in property <length> tile-width: 104px;
    in property <length> content-gutter: 14px;
    in property <bool> drag-selection-active;
    in property <length> drag-selection-start-x;
    in property <length> drag-selection-start-y;
    in property <length> drag-selection-current-x;
    in property <length> drag-selection-current-y;
    out property <bool> location-focused: toolbar.location-focused;
    in-out property <length> viewport-y <=> grid-list.viewport-y;
    callback back-requested();
    callback forward-requested();
    callback parent-requested();
    callback location-focus-changed(bool);
    callback location-submitted(string);
    callback view-mode-requested(ViewMode);
    callback search-changed(string);
    callback search-submitted();
    callback recursive-search-mode-requested(bool);
    callback command-submitted(string);
    callback command-cancelled();
    callback entry-clicked(int);
    callback entry-double-clicked(int);
    callback entry-context-selected(int);
    callback rename-requested(int);
    callback trash-requested(int);
    pure callback entry-drop-allowed(data-transfer, int) -> bool;
    callback entry-dropped(data-transfer, int) -> bool;

    spacing: 0px;

    changed selected-entry => {
        if root.selected-entry < 0 {
            return;
        }
        let row = Math.floor(root.selected-entry / root.columns);
        let item-top = row * 116px;
        let visible-top = -grid-list.viewport-y;
        if item-top < visible-top {
            grid-list.viewport-y = -item-top;
        } else if item-top + 116px > visible-top + grid-list.visible-height {
            grid-list.viewport-y = -(item-top + 116px - grid-list.visible-height);
        }
    }

    toolbar := BrowserToolbar {
        can-go-back: root.can-go-back;
        can-go-forward: root.can-go-forward;
        can-go-parent: root.can-go-parent;
        busy: root.busy;
        location-text <=> root.location-text;
        view-mode: root.view-mode;
        content-gutter: root.content-gutter;
        back-requested => { root.back-requested(); }
        forward-requested => { root.forward-requested(); }
        parent-requested => { root.parent-requested(); }
        location-focus-changed(focused) => { root.location-focus-changed(focused); }
        location-submitted(path) => { root.location-submitted(path); }
        view-mode-requested(mode) => { root.view-mode-requested(mode); }
    }

    Rectangle { height: 1px; background: Palette.border; }

    workspace := Rectangle {
        vertical-stretch: 1;
        background: Palette.background;
        clip: true;

        if root.files.length == 0 && !root.busy && !root.navigation-loading && !root.search-loading : Text {
            text: root.recursive-search-active
                ? root.search-text == "" ? "Type to search subfolders" : "No recursive matches"
                : "This folder is empty";
            color: Palette.foreground;
            opacity: 0.58;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 14px;
        }

        grid-list := ListView {
            x: root.content-gutter;
            y: root.content-gutter;
            width: max(0px, parent.width - 2 * root.content-gutter);
            height: max(0px, parent.height - 2 * root.content-gutter);

            for _[row-index] in root.rows : Rectangle {
                width: parent.width;
                height: 116px;

                for _[column-index] in root.columns : cell := Rectangle {
                    private property <int> item-index: row-index * root.columns + column-index;
                    x: column-index * root.column-width;
                    width: root.column-width;
                    height: 116px;

                    if cell.item-index < root.files.length : FileTile {
                        x: (parent.width - self.width) / 2;
                        width: root.tile-width;
                        height: 108px;
                        item: root.files[cell.item-index];
                        item-index: cell.item-index;
                        selected: root.selected-entries[cell.item-index];
                        drag-enabled: !root.busy && !root.navigation-loading && !root.recursive-search-active;
                        actions-enabled: !root.busy && !root.navigation-loading && !root.recursive-search-active;
                        clicked(index) => { root.entry-clicked(index); }
                        double-clicked(index) => { root.entry-double-clicked(index); }
                        context-selected(index) => { root.entry-context-selected(index); }
                        rename-requested(index) => { root.rename-requested(index); }
                        trash-requested(index) => { root.trash-requested(index); }
                        drop-allowed(data, index) => { root.entry-drop-allowed(data, index) }
                        dropped(data, index) => { root.entry-dropped(data, index) }
                    }
                }
            }
        }

        if root.drag-selection-active : Rectangle {
            x: min(root.drag-selection-start-x, root.drag-selection-current-x);
            y: min(root.drag-selection-start-y, root.drag-selection-current-y);
            width: Math.abs(root.drag-selection-current-x - root.drag-selection-start-x);
            height: Math.abs(root.drag-selection-current-y - root.drag-selection-start-y);
            background: SystemTheme.selection-background.transparentize(0.82);
            border-width: 1px;
            border-color: SystemTheme.accent;
        }
    }

    Rectangle { height: 1px; background: Palette.border; }

    BrowserStatusBar {
        busy: root.busy || root.navigation-loading;
        search-active: root.search-active;
        search-text <=> root.search-text;
        recursive-search-active: root.recursive-search-active;
        search-loading: root.search-loading;
        search-result-count: root.search-result-count;
        search-results-truncated: root.search-results-truncated;
        command-active: root.command-active;
        command-text <=> root.command-text;
        command-prefix: root.command-prefix;
        command-output-active <=> root.command-output-active;
        command-output-summary: root.command-output-summary;
        command-output-detail: root.command-output-detail;
        status-text: root.status-text;
        content-gutter: root.content-gutter;
        search-changed(query) => { root.search-changed(query); }
        search-submitted => { root.search-submitted(); }
        recursive-search-mode-requested(enabled) => { root.recursive-search-mode-requested(enabled); }
        command-submitted(command) => { root.command-submitted(command); }
        command-cancelled => { root.command-cancelled(); }
    }
}
