import { Palette, ScrollView, Spinner } from "std-widgets.slint";
import { SystemTheme } from "../types.slint";

export component BrowserStatusBar inherits Rectangle {
    private property <string> input-font-family: "JetBrainsMono Nerd Font Mono";
    in property <bool> busy;
    in property <bool> search-active;
    in-out property <string> search-text;
    in property <bool> recursive-search-active;
    in property <bool> search-loading;
    in property <int> search-result-count: -1;
    in property <bool> search-results-truncated;
    in property <bool> command-active;
    in-out property <string> command-text;
    in property <string> command-prefix: "!";
    in-out property <bool> command-output-active;
    in property <string> command-output-summary;
    in property <string> command-output-detail;
    in property <string> status-text;
    in property <length> content-gutter: 14px;
    callback search-changed(string);
    callback search-submitted();
    callback recursive-search-mode-requested(bool);
    callback command-submitted(string);
    callback command-cancelled();

    height: root.command-output-active
        ? min(280px, 40px + output-text.preferred-height)
        : 25px;
    background: Palette.alternate-background;
    accessible-role: content-info;
    animate height { duration: 140ms; easing: ease-out; }

    changed search-active => {
        if root.search-active {
            search-input.focus();
        }
    }
    changed command-active => {
        if root.command-active {
            command-input.focus();
        }
    }

    search-prefix := Text {
        visible: root.search-active && !root.command-output-active;
        x: root.content-gutter;
        width: root.recursive-search-active ? 18px : 9px;
        height: parent.height;
        text: root.recursive-search-active ? "//" : "/";
        color: SystemTheme.accent;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Text {
        visible: root.command-active && !root.command-output-active;
        x: root.content-gutter;
        width: 9px;
        height: parent.height;
        text: root.command-prefix;
        color: SystemTheme.accent;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }

    command-field := Rectangle {
        visible: root.command-active && !root.command-output-active;
        x: root.content-gutter + 13px;
        width: max(0px, parent.width - self.x - root.content-gutter);
        height: parent.height;
        clip: true;
        background: transparent;

        command-input := TextInput {
            private property <length> computed-x;

            x: min(0px, max(parent.width - self.width, self.computed-x));
            width: max(1px, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            text <=> root.command-text;
            color: Palette.alternate-foreground;
            font-family: root.input-font-family;
            font-size: 12px;
            single-line: true;
            vertical-alignment: center;
            selection-background-color: SystemTheme.selection-background;
            selection-foreground-color: SystemTheme.selection-foreground;
            accessible-label: root.command-prefix == ":"
                ? "Run a PolarExp or Bash command"
                : "Run a Bash command in the current folder";

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.command-cancelled();
                    return accept;
                }
                return reject;
            }

            cursor-position-changed(position) => {
                if position.x + self.computed-x < 0px {
                    self.computed-x = -position.x;
                } else if position.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - position.x - self.text-cursor-width;
                }
            }
            accepted => { root.command-submitted(self.text); }
        }
    }

    search-field := Rectangle {
        visible: root.search-active && !root.command-output-active;
        x: root.content-gutter + (root.recursive-search-active ? 22px : 13px);
        width: max(0px, parent.width - self.x - root.content-gutter
            - (root.recursive-search-active ? 116px : 0px));
        height: parent.height;
        clip: true;
        background: transparent;

        search-input := TextInput {
            private property <length> computed-x;

            x: min(0px, max(parent.width - self.width, self.computed-x));
            width: max(1px, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            text <=> root.search-text;
            color: Palette.alternate-foreground;
            font-family: root.input-font-family;
            font-size: 12px;
            single-line: true;
            vertical-alignment: center;
            selection-background-color: SystemTheme.selection-background;
            selection-foreground-color: SystemTheme.selection-foreground;
            accessible-label: root.recursive-search-active
                ? "Search file names recursively"
                : "Search file names";

            key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                    return reject;
                }
                if self.text == "" && !root.recursive-search-active && event.text == "/" {
                    root.recursive-search-mode-requested(true);
                    return accept;
                }
                if self.text == "" && root.recursive-search-active && event.text == Key.Backspace {
                    root.recursive-search-mode-requested(false);
                    return accept;
                }
                return reject;
            }

            cursor-position-changed(position) => {
                if position.x + self.computed-x < 0px {
                    self.computed-x = -position.x;
                } else if position.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - position.x - self.text-cursor-width;
                }
            }
            edited => { root.search-changed(self.text); }
            accepted => { root.search-submitted(); }
        }
    }

    if !root.command-output-active && root.search-active && root.recursive-search-active && root.search-loading : Spinner {
        x: parent.width - root.content-gutter - self.width;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        indeterminate: true;
    }

    if !root.command-output-active && root.search-active && root.recursive-search-active && !root.search-loading && root.search-text != "" : Text {
        x: parent.width - root.content-gutter - self.width;
        width: 108px;
        height: parent.height;
        text: root.search-results-truncated
            ? "1000+ matches"
            : "\{root.search-result-count} matches";
        color: Palette.alternate-foreground;
        opacity: 0.58;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    if !root.command-output-active && !root.search-active && !root.command-active && root.busy : Spinner {
        x: root.content-gutter;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        indeterminate: true;
    }

    if !root.command-output-active && !root.search-active && !root.command-active : Text {
        x: root.busy ? root.content-gutter + 20px : root.content-gutter;
        width: parent.width - self.x - root.content-gutter;
        height: parent.height;
        text: root.status-text;
        color: Palette.alternate-foreground;
        opacity: 0.62;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }

    output-panel := Rectangle {
        visible: root.command-output-active;
        z: 2;
        width: parent.width;
        height: parent.height;
        background: Palette.alternate-background;

        Text {
            x: root.content-gutter;
            y: 1px;
            width: max(0px, parent.width - 2 * root.content-gutter - 32px);
            height: 29px;
            text: root.command-output-summary;
            color: Palette.alternate-foreground;
            font-family: root.input-font-family;
            font-size: 11px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        close-output := Rectangle {
            x: parent.width - root.content-gutter - 26px;
            y: 3px;
            width: 26px;
            height: 25px;
            background: transparent;

            Text {
                text: "×";
                color: Palette.alternate-foreground;
                opacity: close-touch.pressed ? 0.45 : close-touch.has-hover ? 1 : 0.62;
                font-size: 17px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                accessible-role: button;
                accessible-label: "Close command output";
                clicked => { root.command-output-active = false; }
            }
        }

        ScrollView {
            x: root.content-gutter;
            y: 31px;
            width: max(0px, parent.width - 2 * root.content-gutter);
            height: max(0px, parent.height - self.y - 9px);
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            viewport-width: self.width;
            viewport-height: max(self.height, output-text.preferred-height);

            output-text := Text {
                width: parent.width;
                height: self.preferred-height;
                text: root.command-output-detail;
                color: Palette.alternate-foreground;
                opacity: 0.84;
                font-family: root.input-font-family;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }
}
