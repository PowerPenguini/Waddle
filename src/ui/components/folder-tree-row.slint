import { Palette, Spinner } from "std-widgets.slint";
import { SystemTheme, FolderIcon, FolderRow } from "../types.slint";

export component FolderTreeRow inherits Rectangle {
    in property <FolderRow> row-data;
    in property <int> row-index;
    in property <bool> drop-enabled;
    private property <length> content-x: 5px + row-data.depth * 16px;
    callback activated(int);
    pure callback drop-allowed(data-transfer, int) -> bool;
    callback dropped(data-transfer, int) -> bool;

    height: 32px;
    border-width: drop-target.has-drag ? 1px : 0px;
    border-color: drop-target.has-drag ? SystemTheme.accent : transparent;
    background: drop-target.has-drag
        ? Palette.control-background
        : row-data.selected
        ? SystemTheme.selection-background.transparentize(0.55)
        : row-touch.has-hover ? Palette.control-background : transparent;
    border-radius: 5px;

    drop-target := DropArea {
        enabled: root.drop-enabled;
        can-drop(event) => {
            root.drop-allowed(event.data, root.row-index)
                ? DragAction.move
                : DragAction.none
        }
        dropped(event) => {
            return root.dropped(event.data, root.row-index)
                ? DragAction.move
                : DragAction.none;
        }

        row-touch := TouchArea {
            accessible-role: list-item;
            accessible-label: root.row-data.label;
            accessible-expandable: root.row-data.expandable;
            accessible-expanded: root.row-data.expanded;
            clicked => { root.activated(root.row-index); }
        }
    }

    if root.row-data.loading : Spinner {
        x: root.content-x;
        y: (root.height - self.height) / 2;
        width: 17px;
        height: 17px;
        indeterminate: true;
    }

    if !root.row-data.loading : Image {
        x: root.content-x;
        y: (root.height - self.height) / 2;
        width: 17px;
        height: 17px;
        source: root.row-data.icon == FolderIcon.computer
            ? @image-url("../icons/computer.svg")
            : root.row-data.icon == FolderIcon.drive
                ? @image-url("../icons/drive.svg")
                : @image-url("../icons/folder.svg");
        colorize: root.row-data.icon == FolderIcon.folder
            ? SystemTheme.accent
            : Palette.alternate-foreground;
    }

    Text {
        x: root.content-x + 23px;
        y: 0;
        width: max(0px, root.width - self.x - 7px);
        height: root.height;
        text: root.row-data.label;
        color: root.row-data.selected
            ? SystemTheme.selection-foreground
            : Palette.alternate-foreground;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
        font-size: 13px;
    }
}
