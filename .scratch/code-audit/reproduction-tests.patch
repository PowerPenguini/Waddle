+        let (tx,rx)=mpsc::channel();
+        std::thread::spawn(move || { let _=tx.send(decode(request)); });
+        let finished=rx.recv_timeout(Duration::from_millis(250));
+        // Unblock the worker even when the regression assertion fails.
+        std::fs::OpenOptions::new().write(true).open(path).unwrap();
+        assert!(finished.is_ok(),"thumbnail decoder blocked opening a named pipe");
+    }
